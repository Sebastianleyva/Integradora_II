install.packages(c(
"tidyverse",
"readr",
"dplyr",
"ggplot2",
"janitor",
"skimr"
))
library(tidyverse)
library(readr)
library(dplyr)
library(ggplot2)
library(janitor)
library(skimr)
# Carga de tus tablas CSV
alumnos  <- read_csv("datos/alumnos.csv")
encuesta <- read_csv("datos/encuesta_general.csv")
registro <- read_csv("datos/registro_diario.csv")
library(tidyverse)
library(janitor)
alumnos  <- alumnos  %>% clean_names()
encuesta <- encuesta %>% clean_names()
registro <- registro %>% clean_names()
library(tidyverse)
library(janitor)
alumnos  <- alumnos  %>% clean_names()
encuesta <- encuesta %>% clean_names()
registro <- registro %>% clean_names()
alumnos  <- read_csv("datos/alumnos.csv")
encuesta <- read_csv("datos/encuesta_general.csv")
registro <- read_csv("datos/registro_diario.csv")
glimpse(alumnos)
library(tidyverse)
library(janitor)
# ==========================================
# 1. ANÁLISIS DE VARIABLES CATEGÓRICAS
# (Tablas de frecuencia y porcentajes)
# ==========================================
# A. Distribución por Sexo
tabla_sexo <- encuesta %>%
tabyl(sexo) %>%
adorn_pct_formatting(digits = 1) %>%
adorn_totals("row")
# B. Prevalencia de Burnout Previo
tabla_burnout <- encuesta %>%
tabyl(burnout_previo) %>%
adorn_pct_formatting(digits = 1) %>%
adorn_totals("row")
# C. Uso de Inteligencia Artificial (en registro diario)
tabla_uso_ia <- registro %>%
tabyl(uso_ia) %>%
adorn_pct_formatting(digits = 1) %>%
adorn_totals("row")
# D. Ámbito de Aplicación de la IA
tabla_app_ia <- registro %>%
tabyl(aplicacion) %>%
adorn_pct_formatting(digits = 1) %>%
adorn_totals("row")
# E. Calidad de Sueño (Ordinal)
tabla_cal_sueno <- registro %>%
tabyl(cal_sueno) %>%
adorn_pct_formatting(digits = 1) %>%
adorn_totals("row")
# Ver tablas en la consola
print(tabla_sexo)
print(tabla_burnout)
print(tabla_uso_ia)
print(tabla_cal_sueno)
# ==========================================
# 2. ANÁLISIS DE VARIABLES NUMÉRICAS
# (Media, Mediana, Mín, Máx, Desviación Estándar)
# ==========================================
# A. Resumen estadístico de la Edad (Encuesta General)
stats_edad <- encuesta %>%
summarise(
Variable = "Edad",
Media = mean(edad, na.rm = TRUE),
Mediana = median(edad, na.rm = TRUE),
DE = sd(edad, na.rm = TRUE),
Min = min(edad, na.rm = TRUE),
Max = max(edad, na.rm = TRUE)
)
# B. Resumen estadístico del Número de Comidas (Registro Diario)
stats_comidas <- registro %>%
summarise(
Variable = "Número de comidas",
Media = mean(n_comidas, na.rm = TRUE),
Mediana = median(n_comidas, na.rm = TRUE),
DE = sd(n_comidas, na.rm = TRUE),
Min = min(n_comidas, na.rm = TRUE),
Max = max(n_comidas, na.rm = TRUE)
)
# Consolidado de métricas numéricas
resumen_numericas <- bind_rows(stats_edad, stats_comidas)
print(resumen_numericas)
# ==========================================
# 3. CRUCES CLAVE PARA DETECTAR PATRONES
# ==========================================
# Relación entre Burnout Previo y Horas/Calidad de Sueño
cruce_burnout_sueno <- registro %>%
inner_join(encuesta, by = "id_alumno") %>%
group_by(burnout_previo, cal_sueno) %>%
summarise(total = n(), .groups = "drop") %>%
mutate(porcentaje = total / sum(total) * 100)
print(cruce_burnout_sueno)
library(ggplot2)
# ----------------------------------------------------
# HALLAZGO 1 - Opción A: Gráfico de Barras (RECOMENDADO)
# ----------------------------------------------------
g1_barras <- ggplot(encuesta, aes(x = burnout_previo, fill = burnout_previo)) +
geom_bar(width = 0.5) +
scale_fill_manual(values = c("FALSE" = "#2b5c8f", "TRUE" = "#d95f02"),
labels = c("Sin Burnout", "Con Burnout")) +
scale_x_discrete(labels = c("FALSE" = "Sin Burnout", "TRUE" = "Con Burnout")) +
labs(
title = "Prevalencia de Burnout en Estudiantes",
subtitle = "Distribución absoluta según antecedente de desgaste académico/laboral",
x = "Estado de Burnout",
y = "Número de Estudiantes",
fill = "Categoría"
) +
theme_minimal()
print(g1_barras)
# ----------------------------------------------------
# HALLAZGO 2 - Opción A: Barras Agrupadas por Calidad de Sueño (RECOMENDADO)
# ----------------------------------------------------
# Preparamos los datos combinados
df_cruce <- registro %>%
inner_join(encuesta, by = "id_alumno") %>%
mutate(burnout_label = if_else(burnout_previo, "Con Burnout", "Sin Burnout"))
g2_barras <- ggplot(df_cruce, aes(x = factor(cal_sueno), fill = burnout_label)) +
geom_bar(position = "dodge") +
scale_fill_manual(values = c("Con Burnout" = "#d95f02", "Sin Burnout" = "#2b5c8f")) +
labs(
title = "Calidad de Sueño según Antecedentes de Burnout",
subtitle = "Frecuencia de puntuaciones en escala de calidad de sueño (2 al 10)",
x = "Calidad de Sueño Percebida",
y = "Frecuencia de Registros",
fill = "Antecedente"
) +
theme_light()
print(g2_barras)
library(ggplot2)
# ====================================================
# HALLAZGO 1 - Opción B: Gráfico de Torta / Pastel (Pie Chart)
# ====================================================
g1_pie <- ggplot(encuesta, aes(x = "", fill = factor(burnout_previo))) +
geom_bar(width = 1) +
coord_polar("y", start = 0) +
scale_fill_manual(
values = c("FALSE" = "#2b5c8f", "TRUE" = "#d95f02"),
labels = c("Sin Burnout (60%)", "Con Burnout (40%)")
) +
labs(
title = "Proporción de Estudiantes con Burnout Previo",
subtitle = "Comparativa de porcentaje total de la muestra (N = 20)",
fill = "Estado"
) +
theme_void()
print(g1_pie)
# ====================================================
# HALLAZGO 2 - Opción B: Gráfico de Puntos / Dispersión con Jitter
# ====================================================
g2_puntos <- ggplot(df_cruce, aes(x = burnout_label, y = cal_sueno, color = burnout_label)) +
geom_jitter(width = 0.15, size = 3, alpha = 0.7) +
scale_color_manual(values = c("Con Burnout" = "#d95f02", "Sin Burnout" = "#2b5c8f")) +
labs(
title = "Distribución de Calidad de Sueño por Grupo",
subtitle = "Dispersión individual de las puntuaciones reportadas",
x = "Grupo de Estudiantes",
y = "Calidad de Sueño (Escala 2-10)",
color = "Antecedente"
) +
theme_minimal() +
theme(legend.position = "none")
print(g2_puntos)
View(alumnos)
View(cruce_burnout_sueno)
View(df_cruce)
View(encuesta)
View(encuesta)
View(registro)
View(tabla_uso_ia)
View(tabla_sexo)
View(tabla_cal_sueno)
