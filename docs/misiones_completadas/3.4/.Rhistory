library(tidyverse)
df_estudio <- registro %>%
mutate(
# Evaluamos cada pilar de forma individual (TRUE = 1, FALSE = 0)
pilar_sueno     = as.integer(h_sueno >= 3 & cal_sueno >= 6),
pilar_comida    = as.integer(n_comidas >= 3 & cal_consumo >= 6),
pilar_tec_horas = as.integer(h_osio <= 2),
pilar_tec_cal   = as.integer(cal_consumo_tec >= 6),
# Sumamos cuántos pilares cumple cada registro (Rango de 0 a 4)
num_pilares = pilar_sueno + pilar_comida + pilar_tec_horas + pilar_tec_cal,
# Agrupamos en niveles de hábito
perfil_habitos = case_when(
num_pilares >= 3 ~ "Hábitos Saludables (3-4 pilares)",
num_pilares == 2 ~ "Hábitos Moderados (2 pilares)",
TRUE             ~ "Hábitos Vulnerables (0-1 pilares)"
)
)
# Resumen de bienestar por nivel de hábitos y uso de IA
resumen_niveles <- df_estudio %>%
group_by(perfil_habitos, uso_ia) %>%
summarise(
bienestar_promedio = mean(pregunta_objetivo, na.rm = TRUE),
total_registros    = n(),
.groups = "drop"
)
print(resumen_niveles)
library(ggplot2)
ggplot(resumen_niveles, aes(x = perfil_habitos, y = bienestar_promedio, fill = factor(uso_ia))) +
geom_bar(stat = "identity", position = position_dodge(width = 0.7), width = 0.6) +
geom_text(
aes(label = round(bienestar_promedio, 2)),
position = position_dodge(width = 0.7),
vjust = -0.5,
size = 3.5,
fontface = "bold"
) +
scale_fill_manual(
values = c("FALSE" = "#2b5c8f", "TRUE" = "#d95f02"),
labels = c("Sin Uso de IA", "Con Uso de IA")
) +
scale_y_continuous(limits = c(0, 10), breaks = seq(0, 10, by = 2)) +
labs(
title = "Efecto Moderador de la Tríada de Hábitos y la IA en el Bienestar",
subtitle = "Comparativa del bienestar promedio (Escala 2-10) según el nivel de vulnerabilidad conductual",
x = "Nivel de Hábitos Conductuales Cumplidos",
y = "Bienestar General Promedio (pregunta_objetivo)",
fill = "Uso de IA"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 11),
legend.position = "bottom",
axis.text.x = element_text(angle = 0, hjust = 0.5)
)
