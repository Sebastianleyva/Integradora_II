library(tidyverse)
# ====================================================
# 1. CONSTRUCCIÓN DEL ÍNDICE REINTEGRAL DE HÁBITOS
# ====================================================
df_estudio <- registro %>%
mutate(
# Evaluamos los 4 pilares biológicos y conductuales
pilar_sueno      = (h_sueno >= 3 & cal_sueno >= 6),
pilar_comida     = (n_comidas >= 3 & cal_consumo >= 6),
pilar_tecnologia = (h_osio <= 2), # Uso saludable: 2 horas o menos
# Índice Global
perfil_habitos = if_else(
pilar_sueno & pilar_comida & pilar_tecnologia,
"Saludable Integral",
"Vulnerable / Desbalanceado"
)
)
# ====================================================
# 2. EVALUACIÓN SOBRE EL BIENESTAR GENERAL (pregunta_objetivo)
# ====================================================
# A. Comparativa del Bienestar Promedio según Perfil de Hábitos
resumen_habitos_bienestar <- df_estudio %>%
group_by(perfil_habitos) %>%
summarise(
bienestar_promedio = mean(pregunta_objetivo, na.rm = TRUE),
mediana_bienestar  = median(pregunta_objetivo, na.rm = TRUE),
total_registros    = n()
)
# B. Impacto del Uso de IA dentro del Perfil Saludable vs. Vulnerable
resumen_triada_ia <- df_estudio %>%
group_by(perfil_habitos, uso_ia) %>%
summarise(
bienestar_promedio = mean(pregunta_objetivo, na.rm = TRUE),
total_registros    = n(),
.groups = "drop"
)
print("--- RESULTADO DEL BIENESTAR SEGÚN EL ÍNDICE COMPLETO ---")
print(resumen_habitos_bienestar)
print("--- IMPACTO DE IA SEGÚN EL PERFIL DE HÁBITOS ---")
print(resumen_triada_ia)
library(ggplot2)
ggplot(df_estudio, aes(x = perfil_habitos, y = pregunta_objetivo, fill = factor(uso_ia))) +
stat_summary(fun = "mean", geom = "bar", position = "dodge", width = 0.5) +
scale_fill_manual(
values = c("FALSE" = "#2b5c8f", "TRUE" = "#d95f02"),
labels = c("Sin Uso de IA", "Con Uso de IA")
) +
scale_y_continuous(limits = c(0, 10), breaks = seq(0, 10, by = 2)) +
labs(
title = "Efecto de la Tríada de Hábitos Integrales y Uso de IA en el Bienestar",
subtitle = "Bienestar promedio (Escala 1-10) considerando horas/calidad de sueño, comida y límites de ocio",
x = "Perfil Conductual del Estudiante",
y = "Bienestar General Promedio (pregunta_objetivo)",
fill = "Uso de Inteligencia Artificial"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 11),
legend.position = "bottom"
)
library(tidyverse)
# ====================================================
# 1. EVALUACIÓN DE TODOS LOS PILARES CONDUCTUALES
# ====================================================
df_estudio <- registro %>%
mutate(
# Evaluamos pilar por pilar (Escala Likert: 2, 4, 6, 8, 10)
pilar_sueno     = (h_sueno >= 3 & cal_sueno >= 6),
pilar_comida    = (n_comidas >= 3 & cal_consumo >= 6),
pilar_tec_horas = (h_osio <= 2),                      # Menos de 2 horas
pilar_tec_cal   = (cal_consumo_tec >= 6),             # Ánimo/Experiencia normal o buena
# Índice Global Integral
perfil_habitos = if_else(
pilar_sueno & pilar_comida & pilar_tec_horas & pilar_tec_cal,
"Saludable Integral",
"Vulnerable / Desbalanceado"
)
)
# ====================================================
# 2. CÁLCULO DE RESULTADOS Y CRUCES DE BIENESTAR
# ====================================================
# A. Promedio de Bienestar General según Perfil de Hábitos
resumen_habitos <- df_estudio %>%
group_by(perfil_habitos) %>%
summarise(
bienestar_promedio = mean(pregunta_objetivo, na.rm = TRUE),
mediana_bienestar  = median(pregunta_objetivo, na.rm = TRUE),
total_registros    = n()
)
# B. Cruce de Perfil de Hábitos con el Uso de IA
resumen_ia <- df_estudio %>%
group_by(perfil_habitos, uso_ia) %>%
summarise(
bienestar_promedio = mean(pregunta_objetivo, na.rm = TRUE),
total_registros    = n(),
.groups = "drop"
)
print("--- RESULTADO DEL BIENESTAR SEGÚN TODOS LOS PILARES ---")
print(resumen_habitos)
print("--- IMPACTO DEL USO DE IA DENTRO DE CADA PERFIL ---")
print(resumen_ia)
library(ggplot2)
ggplot(df_estudio, aes(x = perfil_habitos, y = pregunta_objetivo, fill = factor(uso_ia))) +
stat_summary(fun = "mean", geom = "bar", position = "dodge", width = 0.5) +
scale_fill_manual(
values = c("FALSE" = "#2b5c8f", "TRUE" = "#d95f02"),
labels = c("Sin Uso de IA", "Con Uso de IA")
) +
scale_y_continuous(limits = c(0, 10), breaks = seq(0, 10, by = 2)) +
labs(
title = "Efecto Multidimensional de los Hábitos y la IA en el Bienestar",
subtitle = "Bienestar promedio (Escala 2-10) considerando Sueño, Comida y Experiencia Digital",
x = "Perfil Conductual del Estudiante",
y = "Bienestar General Promedio (pregunta_objetivo)",
fill = "Uso de IA"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 11),
legend.position = "bottom"
)
